{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight-moon",
    "mode": "system"
  },
  "animations": true,
  "cursor": {
    "style": "block",
    "blinking": false
  },
  "session": {
    "thinking": "show",
    "markdown": "rendered",
    "sidebar": "hide",
    "scrollbar": false,
    "image_preview": false,
    "permissions": "prompt"
  },
  "scroll": {
    "speed": 3
  },
  "tabs": {
    "mode": "off",
    "indicators": "status",
    "layout": "horizontal"
  },
  "diffs": {
    "view": "auto",
    "wrap": "word"
  },
  "prompt": {
    "image_preview": false
  },
  "terminal": {
    "title": true
  },
  "debug": {
    "devtools": false
  }
}
