# OS-specific overrides live in an `os.conf` supplied by the per-OS stow layer
# (e.g. os/macos/config/ghostty/os.conf sets the macOS `command`). The leading
# `?` makes it optional: no error on machines where no os layer is stowed.
config-file = ?os.conf

confirm-close-surface = false

font-family = Hack FC Ligatured CCG
# First fallback for anything Hack lacks, ahead of the JetBrains Mono ghostty
# embeds. Hack is a DejaVu Sans Mono fork with identical metrics, so borrowed
# glyphs look native; without it the Dingbats block (the Claude spinner stars)
# straddled two fonts and one frame sat higher than the rest.
font-family = DejaVu Sans Mono
font-size = 12

theme = "tokyonight-moon"

shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = false

window-decoration = none
