{
  "id": "tmux-status",
  "name": "tmux status",
  "description": "Drive the shared Claude/Codex tmux activity renderer from OpenClaw session events.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "renderer": {
        "type": "string",
        "description": "Status renderer; defaults to $XDG_CONFIG_HOME/.claude/hooks/tmux-status.sh."
      }
    }
  }
}
